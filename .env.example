# Copy this file to ".env" and fill it in.
#   cp .env.example .env
#
# The .env file is git-ignored and never leaves your machine.
#
# ─────────────────────────────────────────────────────────────────────
# RECOMMENDED: log in with a browser session cookie (most reliable).
# See the README section "Logging in with a session cookie" for how to
# copy this value from your browser. Leave username/password blank if
# you use this.
# ─────────────────────────────────────────────────────────────────────
IG_SESSIONID=

# ─────────────────────────────────────────────────────────────────────
# FALLBACK: username + password. Instagram often blocks this as a
# "new device" login, so prefer IG_SESSIONID above.
# ─────────────────────────────────────────────────────────────────────
IG_USERNAME=your_instagram_username
IG_PASSWORD=your_instagram_password
